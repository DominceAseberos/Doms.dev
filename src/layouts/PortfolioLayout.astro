---
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://www.dominceaseberos.tech');
const path = Astro.url.pathname;
const nav = [
  { href: '/projects', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/feed', label: 'Feed' },
  { href: '/contact', label: 'Contact' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f3ee" />
    <meta name="description" content={description} />
    <meta name="author" content="Domince Aseberos" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Domince Aseberos Portfolio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://www.dominceaseberos.tech/og-preview.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://www.dominceaseberos.tech/og-preview.png" />
    <title>{title}</title>
  </head>
  <body>
    <header class="portfolio-nav">
      <a class="portfolio-nav__brand" href="/" aria-label="Domince Aseberos, homepage">
        <span>Domince</span><i>Developer</i>
      </a>
      <nav aria-label="Primary navigation">
        {nav.map((item) => <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>)}
      </nav>
      <a class="portfolio-nav__index" href="/projects" aria-label="View project index"><span></span><span></span></a>
    </header>
    <main><slot /></main>
    <footer class="portfolio-footer">
      <div>
        <p>Have an idea?</p>
        <a href="/contact">Let’s make it real <span>↗</span></a>
      </div>
      <div class="portfolio-footer__bottom">
        <span>© {new Date().getFullYear()} Domince Aseberos</span>
        <nav aria-label="Footer navigation">
          <a href="mailto:daseberos@gmail.com">Email</a>
          <a href="https://github.com/DominceAseberos" target="_blank" rel="noreferrer">GitHub</a>
          <a href="https://www.linkedin.com/in/dominceaseberos/" target="_blank" rel="noreferrer">LinkedIn</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,400;1,400&family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600&display=swap');
  :root{--paper:#f4f3ee;--ink:#17181b;--muted:#777872;--line:rgba(23,24,27,.18);--blue:#455ce9;--acid:#d8ff52;--serif:'Bodoni Moda',serif;--sans:'Manrope',sans-serif;--mono:'DM Mono',monospace}
  *,*::before,*::after{box-sizing:border-box}html{background:var(--paper);color:var(--ink)}body{margin:0;min-width:320px;overflow-x:hidden;font-family:var(--sans)}a{color:inherit;text-decoration:none}button,input,textarea{font:inherit}::selection{background:var(--blue);color:#fff}
  .portfolio-nav{height:124px;padding:0 clamp(24px,4vw,64px);display:grid;grid-template-columns:1fr auto 1fr;align-items:center;position:relative;z-index:20;background:var(--paper)}
  .portfolio-nav__brand{width:122px;height:24px;display:grid;overflow:hidden;font-weight:600}.portfolio-nav__brand>*{grid-area:1/1;transition:transform .55s cubic-bezier(.77,0,.18,1)}.portfolio-nav__brand i{font-style:normal;transform:translateY(140%)}.portfolio-nav__brand:hover span{transform:translateY(-140%)}.portfolio-nav__brand:hover i{transform:translateY(0)}
  .portfolio-nav nav{display:flex;gap:clamp(24px,4vw,52px)}.portfolio-nav nav a{position:relative}.portfolio-nav nav a::after{content:'';position:absolute;left:0;right:100%;bottom:-7px;height:1px;background:currentColor;transition:right .35s}.portfolio-nav nav a:hover::after,.portfolio-nav nav a[aria-current='page']::after{right:0}
  .portfolio-nav__index{justify-self:end;width:64px;height:64px;border-radius:50%;background:#deded8;display:grid;place-content:center;gap:6px;transition:background .3s,transform .3s}.portfolio-nav__index:hover{background:var(--blue);transform:rotate(8deg)}.portfolio-nav__index span{width:22px;height:1px;background:currentColor}.portfolio-nav__index:hover span{background:#fff}
  .portfolio-footer{background:#17181b;color:#fff;border-radius:50% 50% 0 0/10vw 10vw 0 0;margin-top:clamp(90px,14vw,210px);padding:clamp(100px,13vw,180px) clamp(24px,6vw,96px) 38px}.portfolio-footer>div:first-child{max-width:1200px;margin:auto}.portfolio-footer p{font-family:var(--mono);text-transform:uppercase;letter-spacing:.16em;font-size:12px;color:#aaa}.portfolio-footer>div:first-child>a{display:flex;justify-content:space-between;align-items:center;font-family:var(--serif);font-size:clamp(48px,8vw,128px);border-bottom:1px solid #555;padding-bottom:24px}.portfolio-footer>div:first-child>a span{font-family:var(--sans);font-size:.5em}.portfolio-footer__bottom{max-width:1200px;margin:70px auto 0;display:flex;justify-content:space-between;color:#aaa;font-size:13px}.portfolio-footer__bottom nav{display:flex;gap:26px}
  @media(max-width:700px){.portfolio-nav{height:90px;grid-template-columns:1fr auto}.portfolio-nav>nav{display:none}.portfolio-nav__index{width:54px;height:54px}.portfolio-footer{border-radius:50% 50% 0 0/5vw 5vw 0 0}.portfolio-footer__bottom{gap:24px;flex-direction:column}.portfolio-footer__bottom nav{flex-wrap:wrap}}
</style>

---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import { CaseStudyPage } from '../../features/site/PortfolioPages';
import portfolioData from '../../data/portfolioData.json';
export function getStaticPaths() { return portfolioData.projects.map((project) => ({ params: { projectId: project.id }, props: { project } })); }
const { project } = Astro.props;
---
<PortfolioLayout title={`${project.title} — Domince Aseberos`} description={project.shortDescription || `View the case study for ${project.title}.`}>
  <CaseStudyPage project={project} client:load />
</PortfolioLayout>

# Copy this file to `.env` and fill in your real values.
# NEVER commit your actual `.env` file — it is git-ignored.
# Any VITE_* / PUBLIC_* variable is exposed to the browser, so never put
# server-only secrets in them.

# GitHub username used by the contribution graph component
VITE_GITHUB_USERNAME=DominceAseberos

# EmailJS (contact form)
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_PUBLIC_KEY=
PUBLIC_EMAILJS_OWNER_TEMPLATE_ID=
PUBLIC_EMAILJS_AUTOREPLY_TEMPLATE_ID=

# Google reCAPTCHA (contact form)
VITE_RECAPTCHA_SITE_KEY=
